# Copy to .env and fill in. .env is git-ignored.

# Address the daemon listens on. Keep 127.0.0.1 for local use.
# For remote access over VPN, set this to the VPN interface address.
RAH_HOST=127.0.0.1
RAH_PORT=8787

# Static access token. Generate a long random value, e.g. `openssl rand -hex 32`.
RAH_TOKEN=

# Where the SQLite database is stored. Relative paths resolve from the directory the daemon starts in.
RAH_DATA_DIR=./data

# Agent executables. Claude: leave empty to use the bundled ACP adapter. pi, agy, traex and codex: leave empty
# to use the one on PATH. An agent that is not installed is simply shown as unavailable.
RAH_CLAUDE_ACP_BIN=
# The claude CLI itself, for local one-shot runs (quota reads, signed-in account discovery).
RAH_CLAUDE_BIN=
RAH_PI_BIN=
RAH_AGY_BIN=
RAH_TRAEX_BIN=
RAH_CODEX_BIN=

# Working directories offered in the UI, comma-separated. Empty means the daemon's start directory.
RAH_WORKDIRS=/path/to/project-a,/path/to/project-b

# Shell that runs in a web terminal. Empty means $SHELL, then /bin/bash.
RAH_TERM_SHELL=

# Other machines: a hub reaches this daemon over SSH through a private unix socket, without the token.
# Empty means ~/.local/state/remote-agent-hub/daemon.sock, where a hub looks for it. `off` turns it off.
RAH_SOCKET=
# The ssh this daemon uses to reach the machines added to it. Empty means the one on PATH.
RAH_SSH_BIN=

# Your own browser on this machine, shown on the VNC desktop; agents drive it with agent-browser.
# Profile (holds your sign-ins). Empty means browser/profile under the data directory.
LIMI_BROWSER_PROFILE=
# X display to show it on. Empty follows the VNC desktop; `off` turns the browser off.
LIMI_BROWSER_DISPLAY=
# Chrome to start. Empty prefers Google Chrome, then Chromium.
LIMI_BROWSER_EXECUTABLE=
# agent-browser, when it is not on PATH (npm install -g agent-browser).
LIMI_AGENT_BROWSER=

# Built web UI to serve at `/`. Leave empty to use packages/web/dist when it exists.
RAH_WEB_DIR=

# Used only by `npm run dev:web` (Vite dev server) to find the daemon.
RAH_DAEMON_URL=http://127.0.0.1:8787
