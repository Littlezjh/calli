#!/usr/bin/env node
import './legacy-env.mjs';
import { personalMain, personalHelp } from './calli-personal.mjs';
import { readFileSync } from 'node:fs';
import { request } from 'node:http';
import { browserMain, notifyMain, previewNoteMain, referencesMain, help as toolsHelp, toolsMain } from './calli-tools.mjs';
const args = process.argv.slice(2);
if (!args.length || (args[0] !== 'browser' && args.includes('--help'))) {
  console.log(`calli agents | status | result ID | stop NAME
calli spawn --agent ID --name NAME [--cwd DIR] [--model ID] [--effort LEVEL] --message-file FILE [--handoff-file FILE] --request-id KEY
calli spawn --fork --name NAME [--worktree] --message-file FILE --request-id KEY
calli send NAME --message-file FILE [--handoff-file FILE] --request-id KEY
calli dirs MACHINE [PATH]
calli remote ls MEMBER [PATH]
calli remote read MEMBER PATH [--offset N] [--limit N]
calli remote write MEMBER PATH --file FILE|- [--expect-hash HASH]
calli handover
calli history THREAD_ID [--before TURN_CURSOR] [--turns N]
calli history THREAD_ID --turn TURN_ID [--offset N --snapshot SNAPSHOT]
calli history THREAD_ID --turn TURN_ID --tool TOOL_ID [--offset N --snapshot SNAPSHOT]
calli history THREAD_ID --tools TURN_ID [--offset N --snapshot SNAPSHOT]
calli history THREAD_ID --input TURN_ID | --answer INPUT_ID
calli history THREAD_ID --user-inputs [--cursor CURSOR] [--turns N]
History options:
  --before TURN_CURSOR  Read older rounds using nextCursor; null means the beginning.
  --turns N             Rounds or inputs per page, default 10, maximum 50.
  --turn TURN_ID        Read one answer in full, in 16000-Unicode-character chunks.
  --tool TOOL_ID        With --turn: one tool call's full record, same chunking.
  --tools TURN_ID       List up to 50 tool ids of that turn; page with --offset.
  --input TURN_ID       Read the person's input text that started that turn.
  --answer INPUT_ID     Read one resolved person answer by input id, same chunking.
  --user-inputs         List only what people said; page with --cursor and nextCursor.
  --offset N            Start at this Unicode character offset (default 0); continue with nextOffset.
  --snapshot SNAPSHOT   Keep the view fixed: the snapshot id (or legacy seq) from the previous response.
  --segment THREAD_ID   Read only one segment of a handed-over chain.
Pages preview up to 4000 answer characters and the latest 30 tools per round; length/truncated and toolCount/toolsOmitted describe omissions.
Run answer.fullText.command to read a truncated answer, then each response's command to continue; null means the end.
Do not combine --turn with --before or --turns. If calli is not on PATH, use "$CALLI_BIN_DIR/calli".
Handover commands are read-only and use CALLI_HANDOVER_SOCKET / CALLI_HANDOVER_KEY; collaboration is not required.
calli team ls
calli team run NAME|ID [--cwd DIR] --task-file FILE|-
calli autohandover THREAD [cancel|off|on|inherit|members off|on|detach|giveback]
  Shows the thread's automatic handover state; cancel calls off an in-flight one; off/on/inherit
  override it for that thread (inherit clears the override); members off|on turns member migration
  off or on for the thread's collaboration (given on its root thread); detach undoes this thread's
  automatic handover chain, restoring the source as an independent conversation; giveback returns
  the collaboration the handover moved (root or member seat) to that source thread, which then
  leads it again.
Team and autohandover commands use CALLI_URL (or CALLI_HOST and CALLI_PORT) and CALLI_TOKEN.
calli ask --text-file FILE|- [--timeout SECONDS]
  Says the text to the personal assistant (Router) and waits for its reply, default 300 seconds.
  Prints {threadId, reply}; reply is null when the assistant has not answered in time. Same credentials as team.
FILE may be - for stdin. Reuse the request ID only when retrying the same request.
Members can message existing teammates; only the lead can spawn or stop members.
A remote member's task is also written to a handoff markdown file on its machine, and the result it
writes there comes back as a file; --handoff-file makes a local file the body of that handoff.
calli remote reads and writes files through relay inside MEMBER's own folder on that machine; the lead may
write, other members may only read. Paths outside it are refused.
An agent ID like AGENT@MACHINE runs on another machine: --cwd is required, an absolute path there (calli dirs MACHINE [PATH] lists its folders), and that member cannot use calli; its final reply is its result.

${toolsHelp}

${personalHelp}`);
  process.exit(0);
}
try {
  if (args[0] === 'agents' && !process.env.CALLI_TEAM_SOCKET && (process.env.CALLI_TODO_SOCKET || process.env.CALLI_TODO_KEY)) { await personalMain(args); process.exit(0); }
  if (['todo', 'threads', 'wish', 'quiet', 'review', 'profile', 'settings', 'signals', 'dispatch', 'plan', 'prep'].includes(args[0])) { await personalMain(args); process.exit(0); }
  if (args[0] === 'preview-note') { await previewNoteMain(args.slice(1)); process.exit(0); }
  if (args[0] === 'references') { await referencesMain(args.slice(1)); process.exit(0); }
  if (args[0] === 'notify') { await notifyMain(args.slice(1)); process.exit(0); }
  if (args[0] === 'browser') {
    process.exit(await browserMain(args.slice(1)));
  }
  if (args[0] === 'tools' || args[0] === 'jobs') {
    await toolsMain(args);
    process.exit(process.exitCode ?? 0);
  }
  if (args[0] === 'team' || args[0] === 'ask') {
    // Like scripts/restart.sh: a hub bound to one interface is not on loopback.
    const host = !process.env.CALLI_HOST || ['0.0.0.0', '::'].includes(process.env.CALLI_HOST) ? '127.0.0.1' : process.env.CALLI_HOST;
    const base = process.env.CALLI_URL || `http://${host.includes(':') ? `[${host}]` : host}:${process.env.CALLI_PORT || 8787}`;
    const token = process.env.CALLI_TOKEN;
    if (!token) throw new Error(`Set CALLI_TOKEN for ${args[0]} commands.`);
    const api = async (path, body) => {
      const response = await fetch(new URL(path, base), { method: body ? 'POST' : 'GET', signal: AbortSignal.timeout(30000), headers: { Authorization: `Bearer ${token}`, 'Content-Type': 'application/json' }, ...(body ? { body: JSON.stringify(body) } : {}) });
      const value = await response.json();
      if (!response.ok) throw new Error(value.error || `HTTP ${response.status}`);
      return value;
    };
    if (args[0] === 'ask') {
      const flags = args.slice(1); let file, timeout = 300;
      while (flags.length) {
        const flag = flags.shift(), value = flags.shift();
        if (value === undefined) throw new Error(`Missing value: ${flag}`);
        if (flag === '--text-file') file = value;
        else if (flag === '--timeout' && Number(value) > 0) timeout = Number(value);
        else throw new Error(`Invalid argument: ${flag}`);
      }
      if (!file) throw new Error('Give --text-file FILE or --text-file - for stdin.');
      const text = readFileSync(file === '-' ? 0 : file, 'utf8');
      // A reply counts only once the Router is idle again and its cached reply has changed.
      const before = (await api('/api/personal/router')).lastReplyAt;
      const { threadId } = await api('/api/personal/say', { text });
      const deadline = Date.now() + timeout * 1000;
      let reply = null;
      while (Date.now() < deadline) {
        await new Promise(r => setTimeout(r, 500));
        const status = await api('/api/personal/router');
        if (status.threadId === threadId && status.status === 'idle' && status.lastReplyAt !== before) { reply = status.lastReply; break; }
      }
      console.log(JSON.stringify({ threadId, reply }));
      process.exit(0);
    }
    const [, command, ...flags] = args;
    if (command === 'ls' && !flags.length) console.log(JSON.stringify(await api('/api/teams')));
    else if (command === 'run') {
      const target = flags.shift(); let cwd = process.cwd(), file;
      if (!target || target.startsWith('--')) throw new Error('Give a team name or ID.');
      while (flags.length) {
        const flag = flags.shift(), value = flags.shift();
        if (value === undefined) throw new Error(`Missing value: ${flag}`);
        if (flag === '--cwd') cwd = value;
        else if (flag === '--task-file') file = value;
        else throw new Error(`Invalid argument: ${flag}`);
      }
      if (!file) throw new Error('Give --task-file FILE or --task-file - for stdin.');
      const teams = await api('/api/teams');
      const team = teams.find(t => t.id === target) || teams.find(t => t.name === target);
      if (!team) throw new Error(`Team not found: ${target}`);
      console.log(JSON.stringify(await api(`/api/teams/${encodeURIComponent(team.id)}/tasks`, { text: readFileSync(file === '-' ? 0 : file, 'utf8'), cwd, source: { kind: 'cli' } })));
    } else throw new Error('Use calli team ls or calli team run NAME|ID --task-file FILE.');
    process.exit(0);
  }
  if (args[0] === 'autohandover') {
    // Same credential as team/ask: the person's token for the hub's HTTP API.
    const host = !process.env.CALLI_HOST || ['0.0.0.0', '::'].includes(process.env.CALLI_HOST) ? '127.0.0.1' : process.env.CALLI_HOST;
    const base = process.env.CALLI_URL || `http://${host.includes(':') ? `[${host}]` : host}:${process.env.CALLI_PORT || 8787}`;
    const token = process.env.CALLI_TOKEN;
    if (!token) throw new Error('Set CALLI_TOKEN for autohandover commands.');
    const api = async (path, method, body) => {
      const response = await fetch(new URL(path, base), { method, signal: AbortSignal.timeout(30000), headers: { Authorization: `Bearer ${token}`, 'Content-Type': 'application/json' }, ...(body !== undefined ? { body: JSON.stringify(body) } : {}) });
      const value = await response.json().catch(() => ({}));
      if (!response.ok) throw new Error(value.error || `HTTP ${response.status}`);
      return value;
    };
    const usage = 'Use calli autohandover THREAD [cancel|off|on|inherit|members off|on|detach].';
    const [id, action, value] = args.slice(1);
    if (!id || id.startsWith('--') || value !== undefined && action !== 'members') throw new Error(usage);
    const thread = encodeURIComponent(id);
    if (!action) console.log(JSON.stringify(await api(`/api/threads/${thread}/auto-handover`, 'GET')));
    else if (action === 'cancel' ) console.log(JSON.stringify(await api(`/api/threads/${thread}/auto-handover`, 'DELETE')));
    else if (action === 'off' || action === 'on' || action === 'inherit')
      console.log(JSON.stringify(await api(`/api/threads/${thread}/auto-handover`, 'PATCH', { enabled: action === 'off' ? false : action === 'on' ? true : null })));
    else if (action === 'members' && (value === 'off' || value === 'on'))
      console.log(JSON.stringify(await api(`/api/threads/${thread}/collaboration-handover`, 'PATCH', { enabled: value === 'on' })));
    else if (action === 'detach') console.log(JSON.stringify(await api(`/api/threads/${thread}/handover-link`, 'DELETE')));
    else if (action === 'giveback') console.log(JSON.stringify(await api(`/api/threads/${thread}/handback`, 'POST', {})));
    else throw new Error(usage);
    process.exit(0);
  }
  const send = (input, readonly) => {
    const tools = readonly && Boolean(process.env.CALLI_TOOLS_SOCKET || process.env.CALLI_TOOLS_KEY);
    const socket = readonly ? tools ? process.env.CALLI_TOOLS_SOCKET : process.env.CALLI_HANDOVER_SOCKET : process.env.CALLI_TEAM_SOCKET;
    const key = readonly ? tools ? process.env.CALLI_TOOLS_KEY : process.env.CALLI_HANDOVER_KEY : process.env.CALLI_TEAM_KEY;
    if (!socket || !key) throw new Error(readonly ? 'Run this command inside a Calli thread with read credentials.' : 'Enable collaboration in calli before running this command.');
    const payload = JSON.stringify(input);
    const req = request({ socketPath: socket, path: readonly && !tools ? '/handover' : '/command', method: 'POST', headers: { Authorization: `Bearer ${key}`, 'Content-Type': 'application/json', 'Content-Length': Buffer.byteLength(payload) } }, res => {
      let text = ''; res.setEncoding('utf8'); res.on('data', chunk => { text += chunk; });
      res.on('end', () => { console.log(text); if (res.statusCode >= 400) process.exitCode = 1; });
    });
    req.setTimeout(30000, () => req.destroy(new Error('Timed out; retry with the same request-id.')));
    req.on('error', err => { console.error(err.message); process.exitCode = 1; });
    req.end(payload);
  };

  if (args[0] === 'remote') {
    const [, action, member, ...rest] = args;
    if (!['ls', 'read', 'write'].includes(action) || !member) throw new Error('Use calli remote ls|read|write MEMBER [PATH] [options].');
    const input = { op: 'remote', action, target: member };
    if (rest[0] && !rest[0].startsWith('--')) input.path = rest.shift();
    if (action !== 'ls' && input.path === undefined) throw new Error('Give the path of the file.');
    while (rest.length) {
      const flag = rest.shift(); const value = rest.shift();
      if (value === undefined) throw new Error(`Missing value: ${flag}`);
      if (flag === '--offset') input.offset = Number(value);
      else if (flag === '--limit') input.limit = Number(value);
      else if (flag === '--expect-hash') input.expectHash = value;
      else if (flag === '--file' && action === 'write') input.file = value;
      else throw new Error(`Invalid argument: ${flag}`);
    }
    if (action === 'write') {
      if (!input.file) throw new Error('Give --file FILE or --file - for stdin.');
      input.text = readFileSync(input.file === '-' ? 0 : input.file, 'utf8');
      delete input.file;
      if (Buffer.byteLength(input.text) > 1024 * 1024) throw new Error('The file is over the 1 MB limit.');
    }
    send(input, false);
  } else {
    const [op, ...rest] = args;
    const input = { op };
    if (rest[0] && !rest[0].startsWith('--')) input.target = rest.shift();
    const readonly = op === 'handover' || op === 'history';
    if (op === 'dirs' && rest[0] && !rest[0].startsWith('--')) input.path = rest.shift();
    const names = readonly ? { '--before': 'before', '--turns': 'turns', '--turn': 'turn', '--offset': 'offset', '--snapshot': 'snapshot', '--tool': 'tool', '--tools': 'tools', '--input': 'input', '--answer': 'answer', '--cursor': 'cursor', '--segment': 'segment' } : { '--agent': 'agent', '--name': 'name', '--cwd': 'cwd', '--model': 'model', '--effort': 'effort', '--request-id': 'requestId', '--message-file': 'file', '--handoff-file': 'handoffFile' };
    while (rest.length) {
      const flag = rest.shift();
      if (op === 'spawn' && (flag === '--fork' || flag === '--worktree')) {
        if (input[flag.slice(2)]) throw new Error(`Duplicate argument: ${flag}`);
        input[flag.slice(2)] = true; continue;
      }
      if (readonly && flag === '--user-inputs') {
        if (input.userInputs) throw new Error(`Duplicate argument: ${flag}`);
        input.userInputs = true; continue;
      }
      const key = names[flag]; const value = rest.shift();
      if (!key || value === undefined || input[key] !== undefined) throw new Error(`Invalid argument: ${flag}`);
      input[key] = value;
    }
    if (input.file === '-' && input.handoffFile === '-') throw new Error('Only one file can come from stdin.');
    if (input.file) { input.text = readFileSync(input.file === '-' ? 0 : input.file, 'utf8'); delete input.file; }
    if (input.handoffFile) {
      input.handoff = readFileSync(input.handoffFile === '-' ? 0 : input.handoffFile, 'utf8');
      delete input.handoffFile;
      if (input.handoff.length > 64000) throw new Error('The handoff file is over the 64000 character limit.');
    }
    if (op === 'handover' && Object.keys(input).length > 1) throw new Error('Use calli handover without arguments.');
    if (op === 'history' && !input.target) throw new Error('Give a thread ID from calli handover.');
    send(input, readonly);
  }
} catch (err) { console.error(err.message); process.exitCode = 1; }
